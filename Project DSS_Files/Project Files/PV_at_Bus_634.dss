~ mult=(0.6 0.55 0.5 0.5 0.55 0.7 0.9 1.1 1.2 1.3 1.4 1.45 1.5 1.45 1.4 1.35 1.3 1.25 1.2 1.1 1.0 0.9 0.8 0.7)

BatchEdit Load..* daily=Daily24



New Loadshape.SolarShape npts=24 interval=1
~ mult=(0 0 0.05 0.15 0.35 0.65 0.85 1.0 0.92 0.78 0.72 0.68 0.55 0.42 0.28 0.18 0.08 0 0 0 0 0 0 0)

!================ BEFORE PV =================

New Monitor.Volt634_Before Element=Transformer.XFM1 Terminal=2 Mode=0

Set Voltagebases=[115, 4.16, .48]
CalcVoltageBases

Set mode=daily stepsize=1h number=24
Set Controlmode=STATIC

Solve

! ---- BEFORE PV OUTPUTS ----
Show Voltages
Show Losses

Export Voltages filename=PU_Voltages_BeforeP634.csv
Export Losses filename=Losses_BeforePV634.csv
Show Monitor Volt634_Before
Export Monitor Volt634_Before fllename=VoltagesbeforePV634.csv


!================ PV SYSTEM AT BUS 634 =================

New PVSystem.PV634 
~ Bus1=634.1.2.3 
~ Phases=3 
~ Conn=Wye 
~ kV=0.48 
~ kVA=100
~ Pmpp=100
~ %Cutin=2
~ %Cutout=2
~ PF=0.97
~ Irradiance=1

Edit PVSystem.PV634 daily=SolarShape
New XYCurve.VVCurve634  npts=4 xarray=[0.95 0.98 1.02 1.05] yarray=[0.5 0 -0 -0.5]


New InvControl.PV634_Control
~ DERList=PVSystem.PV634
~ Mode=VOLTVAR
~ vvc_curve=VVCurve634

~ RefReactivePower=VARMAX


!================ AFTER PV =================

New Monitor.Volt634_After Element=Transformer.XFM1 Terminal=2 Mode=0

Set mode=daily stepsize=1h number=24
Set Controlmode=STATIC
Set MaxControlIter=100

Solve

! ---- AFTER PV OUTPUTS ----
Show Voltages
Show Losses

Export Monitor Volt634_After fllename=VoltagesafterPV634.csv
Export Losses filename=Losses_AfterPV634.csv
Export voltages filename=PU_voltages634_AfterPV.csv
Show Monitor Volt634_After 



