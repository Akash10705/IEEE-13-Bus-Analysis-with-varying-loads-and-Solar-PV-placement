!================ BEFORE PV =================
New Monitor.Bus680_before Element=Line.671680 Terminal=2 Mode=0
New Monitor.Bus671_before Element=Line.671680 Terminal=1 Mode=0

Set Voltagebases=[115, 4.16, .48]
CalcVoltageBases
Set Controlmode=STATIC

Set mode=daily stepsize=1h number=24
Solve

Show Voltages
Show Losses
Export Voltages filename=Bus680_before.csv
Show Monitor Bus680_before
Show Monitor Bus671_before

Export Losses filename=Losses_BeforePV680.csv

