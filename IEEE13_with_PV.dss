New Loadshape.Daily24 npts=24 interval=1
~ mult=(0.60 0.55 0.50 0.45 0.40 0.45 0.60 0.75 0.90 1.00 1.10 1.15 1.20 1.25 1.20 1.15 1.10 1.20 1.35 1.50 1.40 1.20 0.95 0.75)

BatchEdit Load..* daily=Daily24
New Monitor.Bus675_Voltage_PV_before_PV Element=Line.692675 Terminal=2 Mode=0

!================ BEFORE PV =================
Set Voltagebases=[115, 4.16, .48]
CalcVoltageBases
Set mode=daily stepsize=1h number=24
Set Controlmode=STATIC

Solve

Show Voltages
Show Losses
Show Monitor Bus675_Voltage_PV_before_PV
!!Export Monitor Bus611_Voltage_PV_before_PV filename=Voltages_before_PV611.csv
!Export Losses filename=Losses_before_PV671.csv

!================ PV SYSTEM (AT BUS 671) ================
New PVSystem.PV675 
~ Bus1=675.1.2.3 
~ Phases=3 
~ Conn=Wye
~ kV=2.4
~ kVA=350
~ Pmpp=350
~ %Cutin=0.1
~ %Cutout=0.1

!================ SOLAR SHAPE =================
New Loadshape.Daily24 npts=24 interval=1
~ mult=(0.60 0.55 0.50 0.45 0.40 0.45 0.60 0.75 0.90 1.00 1.10 1.15 1.20 1.25 1.20 1.15 1.10 1.20 1.35 1.50 1.40 1.20 0.95 0.75)

New Loadshape.SolarShape npts=24 interval=1
~ mult=(0 0 0 0 0 0.05 0.20 0.40 0.6 0.8 0.9 0.95 0.9 0.85 0.75 0.55 0.35 0.15 0.05 0 0 0 0 0)

Edit PVSystem.PV671 daily=SolarShape
New Monitor.Bus675_Voltage_PV_after_PV Element=Line.692675 Terminal=2 Mode=0

!================ AFTER PV =================

Set mode=daily stepsize=1h number=24
Set Controlmode=STATIC
Set MaxControlIter=100
Solve

Show Losses
Show Voltages pu

!Export Losses filename=Losses_AfterPV671.csv
!Export Monitor Bus611_Voltage_PV_after_PV filename=Voltages_After_PV671.csv
Show Monitor Bus675_Voltage_PV_after_PV


